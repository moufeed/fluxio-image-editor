{
  "name": "fluxio-image-editor-workspace",
  "version": "0.0.0",
  "scripts": {
    "commit": "git add . && cz",
    "commit:wip": "git add . && cz --no-verify",
    "changelog": "npx git-cliff -o projects/fluxio-image-editor/CHANGELOG.md",
    "prepare": "lefthook install",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ng": "ng",
    "start": "ng serve demo",
    "start:demo": "ng serve demo",
    "start:demo:csp": "ng serve demo --configuration=csp",
    "start:docs": "ng serve docs",
    "build": "ng build fluxio-image-editor && ng build demo",
    "build:lib": "ng build fluxio-image-editor",
    "build:demo": "ng build demo",
    "build:demo:csp": "ng build demo --configuration=csp",
    "build:docs": "ng build docs",
    "build:docs:pages": "ng build docs --base-href /fluxio-image-editor/",
    "pack:lib": "npm run build:lib && npm pack ./dist/fluxio-image-editor --dry-run",
    "docs:catalog": "node tools/docs-catalog.mjs",
    "bundle:compare": "node tools/bundle-compare.mjs",
    "perf:pv45": "node tools/perf-pv45.mjs",
    "watch": "ng build fluxio-image-editor --watch --configuration development",
    "test": "node tools/check-architecture.mjs && ng test fluxio-image-editor --watch=false",
    "test:unit": "ng test fluxio-image-editor --watch=false",
    "test:architecture": "node tools/check-architecture.mjs",
    "test:demo": "ng test demo --watch=false",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:browsers": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:csp": "node tools/run-e2e-csp.mjs"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "fabric": "^6.9.1",
    "nanoid": "^6.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.3",
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.0",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.54.2",
    "@types/fabric": "^5.3.11",
    "@types/node": "^26.1.2",
    "angular-eslint": "^21.4.0",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "depcheck": "^1.4.7",
    "eslint": "^9.39.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "git-cliff": "^2.13.1",
    "jsdom": "^28.1.0",
    "lefthook": "^2.1.9",
    "lint-staged": "^17.0.8",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.10"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
